// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MealType {
  BREAKFAST
  LUNCH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum AttendanceSource {
  USER_MANUAL
  ADMIN_OVERRIDE
  AUTO_RESERVATION
  LEGACY_WEEKLY_PLAN
}

enum UserRole {
  USER
  ADMIN
  REPORTER
}

enum CalendarDateSystem {
  GREGORIAN
  JALALI
  HIJRI
}

enum CalendarEventType {
  NATIONAL
  RELIGIOUS
  INTERNATIONAL
  CULTURAL
  ORGANIZATIONAL
  OFFICIAL
  OTHER
}

enum CalendarEventSourceSection {
  MAIN_MONTH_TABLE
  APPENDIX_TABLE
  ASTRONOMICAL_NOTES
  MANUAL
}

enum CalendarOverrideType {
  FORCE_HOLIDAY
  FORCE_WORKDAY
}

enum CalendarImportStatus {
  DRAFT
  IMPORTED
  VERIFIED
  REJECTED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT

  USER_CREATED
  USER_STATUS_CHANGED
  USER_PASSWORD_RESET

  PROFILE_UPDATED
  MY_PASSWORD_CHANGED
  AVATAR_UPDATED
  AVATAR_DELETED

  ATTENDANCE_UPDATED
  MONTHLY_ATTENDANCE_UPDATED
  WEEKLY_ATTENDANCE_GENERATED
  WEEKLY_PREFERENCES_UPDATED

  CALENDAR_OVERRIDE_FORCE_HOLIDAY
  CALENDAR_OVERRIDE_FORCE_WORKDAY
  CALENDAR_OVERRIDE_CLEARED

  REPORT_EXPORTED

  GUEST_MEAL_CREATED
  GUEST_MEAL_DELETED
  ATTENDANCE_OVERRIDE_APPLIED
  ATTENDANCE_OVERRIDE_CLEARED
  ATTENDANCE_OVERRIDE_BLOCKED
  AUTO_RESERVATION_CHANGED
  ATTENDANCE_RECONCILED
  AUTOMATION_CONFIG_CHANGED
  AUTOMATION_RUN_REQUESTED
  CALENDAR_DATASET_APPLIED
}

enum AuditTargetType {
  AUTH
  SESSION
  USER
  PROFILE
  AVATAR
  MEAL_ATTENDANCE
  WEEKLY_MEAL_PREFERENCE
  CALENDAR_OVERRIDE
  CALENDAR_DAY
  REPORT
  GUEST_MEAL_ORDER
  SYSTEM
}

enum AuditStatus {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  name            String
  email           String?   @unique
  passwordHash    String?
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true)
  firstName       String?
  lastName        String?
  avatarImage     Bytes?
  avatarMimeType  String?
  avatarUpdatedAt DateTime?
  autoBreakfast Boolean @default(false)
  autoLunch Boolean @default(false)
  autoBreakfastFrom DateTime? @db.Date
  autoLunchFrom DateTime? @db.Date

  weeklyPreferences     WeeklyMealPreference[]
  attendances           MealAttendance[]
  attendanceDecisions   AttendanceDecision[]
  sessions              Session[]
  calendarOverrides     CalendarOverride[]     @relation("CalendarOverrideCreatedBy")
  calendarImportBatches CalendarImportBatch[]  @relation("CalendarImportBatchCreatedBy")
  auditLogs             AuditLog[]             @relation("AuditLogActor")
  guestMealOrders       GuestMealOrder[]       @relation("GuestMealOrderCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  occurredAt DateTime @default(now())

  actorUserId String?
  actorUser   User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorUsername String?
  actorName     String?
  actorRole     UserRole?

  action      AuditAction
  targetType  AuditTargetType
  targetId    String?
  targetLabel String?

  status AuditStatus @default(SUCCESS)

  requestMethod String?
  requestPath   String?
  ipAddress     String?
  userAgent     String?

  before   Json?
  after    Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([occurredAt])
  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model WeeklyMealPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 0 = Saturday, 1 = Sunday, ..., 6 = Friday
  dayOfWeek Int

  mealType  MealType
  isEnabled Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek, mealType])
  @@index([dayOfWeek, mealType])
}

model MealAttendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime         @db.Date
  mealType MealType
  status   AttendanceStatus @default(PRESENT)

  generatedFromWeeklyPlan Boolean @default(false)
  manuallyEdited          Boolean @default(false)
  source AttendanceSource @default(USER_MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, mealType])
  @@index([date, mealType])
  @@index([userId, date])
}

/// Preserves lower-priority decisions while an admin override is effective.
/// AUTO_RESERVATION is computed from User settings, never a decision here.
model AttendanceDecision {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  mealType MealType
  source AttendanceSource
  status AttendanceStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, date, mealType, source])
  @@index([date, userId])
}

model GuestMealOrder {
  id String @id @default(cuid())

  date DateTime @db.Date
  mealType MealType

  title String
  guestName String?
  organization String?
  count Int @default(1)
  note String?

  createdById String?
  createdBy User? @relation("GuestMealOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, mealType])
  @@index([createdById])
}

model CalendarImportBatch {
  id String @id @default(cuid())

  year       Int
  yearSystem CalendarDateSystem @default(JALALI)

  sourceName    String
  sourceUrl     String?
  sourceVersion String?
  notes         String?

  status     CalendarImportStatus @default(DRAFT)
  importedAt DateTime?
  verifiedAt DateTime?

  createdById String?
  createdBy   User?   @relation("CalendarImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  calendarDays   CalendarDay[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, yearSystem])
  @@index([status])
  @@index([createdById])
}

model CalendarDay {
  id String @id @default(cuid())

  date    DateTime @unique @db.Date
  dateKey String   @unique

  gregorianYear  Int
  gregorianMonth Int
  gregorianDay   Int

  jalaliYear    Int
  jalaliMonth   Int
  jalaliDay     Int
  jalaliDateKey String @unique

  hijriYear    Int?
  hijriMonth   Int?
  hijriDay     Int?
  hijriDateKey String?

  /// 0 = Saturday, 1 = Sunday, ..., 6 = Friday
  dayOfWeek Int
  dayNameFa String

  isWeeklyOffDay    Boolean @default(false)
  isOfficialHoliday Boolean @default(false)
  isManualHoliday   Boolean @default(false)
  isForcedWorkday   Boolean @default(false)

  /// Final decision used by the application.
  isWorkday Boolean @default(true)

  holidayTitle String?
  description  String?

  sourceName    String?
  sourceVersion String?
  verifiedAt    DateTime?

  importBatchId String?
  importBatch   CalendarImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  events   CalendarEvent[]
  override CalendarOverride?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([dateKey])
  @@index([jalaliYear, jalaliMonth])
  @@index([jalaliDateKey])
  @@index([dayOfWeek])
  @@index([isWorkday])
  @@index([isOfficialHoliday])
  @@index([isWeeklyOffDay])
  @@index([date, isWorkday])
}

model CalendarEvent {
  id String @id @default(cuid())

  eventKey String? @unique

  calendarDayId String
  calendarDay   CalendarDay @relation(fields: [calendarDayId], references: [id], onDelete: Cascade)

  title        String
  displayOrder Int                @default(0)
  type         CalendarEventType
  calendarType CalendarDateSystem

  isHoliday  Boolean @default(false)
  isOfficial Boolean @default(true)

  referenceDate String?
  description   String?

  sourceName    String?
  sourceVersion String?
  sourcePage    Int?
  sourceSection CalendarEventSourceSection?

  importBatchId String?
  importBatch   CalendarImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calendarDayId])
  @@index([calendarDayId, displayOrder])
  @@index([type])
  @@index([calendarType])
  @@index([isHoliday])
  @@index([isOfficial])
  @@index([sourcePage])
  @@index([sourceSection])
  @@index([importBatchId])
}

model CalendarOverride {
  id String @id @default(cuid())

  calendarDayId String      @unique
  calendarDay   CalendarDay @relation(fields: [calendarDayId], references: [id], onDelete: Cascade)

  date    DateTime @db.Date
  dateKey String

  type        CalendarOverrideType
  title       String
  description String?

  createdById String?
  createdBy   User?   @relation("CalendarOverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([dateKey])
  @@index([type])
  @@index([createdById])
}

enum AutomationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  BLOCKED
  MANUAL_ACTION_REQUIRED
  SKIPPED
}

model AutomationConfig {
  id String @id @default("singleton")
  reporterEnabled Boolean @default(false)
  calendarEnabled Boolean @default(false)
  nextcloudBaseUrl String @default("")
  reportsDirectory String @default("/StoreX-Automation/Reports")
  calendarDirectory String @default("/StoreX-Automation/Calendar")
  reportRecipient String @default("")
  technicalConversation String @default("")
  reminder1 String @default("09:20")
  reminder2 String @default("09:25")
  deliveryTime String @default("09:30")
  retry1 String @default("09:40")
  retry2 String @default("09:50")
  finalRetry String @default("10:00")
  calendarSourceOverride String @default("")
  publicSharingState String @default("UNKNOWN")
  capabilityCheckedAt DateTime?
  health Json?
  updatedAt DateTime @updatedAt
}

model AutomationJobRun {
  id String @id @default(cuid())
  jobType String
  executionKey String @unique
  target String
  attempt Int @default(0)
  status AutomationStatus @default(PENDING)
  stage String @default("PENDING")
  startedAt DateTime?
  finishedAt DateTime?
  nextRetryAt DateTime?
  errorCode String?
  errorMessage String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextRetryAt])
  @@index([jobType, target])
}

model AutomationArtifact {
  id String @id @default(cuid())
  artifactKey String @unique
  type String
  target String
  sha256 String
  spoolPath String
  nextcloudPath String?
  uploadState String @default("PENDING")
  retainUntil DateTime?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries ReportDelivery[]
  @@index([uploadState])
}

model ReportDelivery {
  id String @id @default(cuid())
  reportDateKey String @unique
  artifactId String?
  artifact AutomationArtifact? @relation(fields:[artifactId],references:[id],onDelete:Restrict)
  stage String @default("PENDING")
  status AutomationStatus @default(PENDING)
  shareId String?
  publicUrl String?
  shareCreatedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  sentAt DateTime?
  baleMessageId String?
  nextRetryAt DateTime?
  cleanupError String?
  snapshot Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([expiresAt, revokedAt])
}

model AutomationAlert {
  id String @id @default(cuid())
  alertKey String @unique
  jobType String
  target String
  message String
  status AutomationStatus @default(PENDING)
  remoteMessageId String?
  createdAt DateTime @default(now())
  sentAt DateTime?
}

model CalendarDataset {
  id String @id @default(cuid())
  year Int
  sourceName String
  sourceUrl String?
  sourceHash String
  parserVersion String
  status String @default("STAGED")
  payload Json
  diff Json?
  importBatchId String?
  approvedById String?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([year, sourceName, sourceHash])
  @@index([year, status])
}

/// Durable expiry tracking for non-report capability probes.
model AutomationShareLease {
  id String @id @default(cuid())
  leaseKey String @unique
  nextcloudPath String
  shareId String?
  publicUrl String?
  shareCreatedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  cleanupError String?
  createdAt DateTime @default(now())
  @@index([expiresAt, revokedAt])
}

// References change atomically; normalized image bytes live in durable storage.
model BrandingAsset {
  hash String @id
  width Int
  height Int
  byteSize Int
  createdAt DateTime @default(now())
  activeConfigurations BrandingConfig[] @relation("ActiveBranding")
  previousConfigurations BrandingConfig[] @relation("PreviousBranding")
}
model BrandingConfig {
  id String @id @default("singleton")
  activeHash String?
  activeAsset BrandingAsset? @relation("ActiveBranding", fields: [activeHash], references: [hash], onDelete: Restrict)
  previousHash String?
  previousAsset BrandingAsset? @relation("PreviousBranding", fields: [previousHash], references: [hash], onDelete: Restrict)
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}
model BrandingAudit {
  id String @id @default(cuid())
  actorUserId String
  actorUsername String
  actorName String
  action String
  fromHash String?
  toHash String?
  revision Int
  occurredAt DateTime @default(now())
  @@index([occurredAt])
}
