# Copy to /etc/storex/automation.env (root:storex, mode 0640); replace placeholders.
NODE_ENV=production
TZ=Asia/Tehran
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE
NEXTCLOUD_USERNAME=SERVICE_ACCOUNT
NEXTCLOUD_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD
BALE_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
AUTOMATION_ALLOWED_NEXTCLOUD_HOSTS=cloud.example.org
AUTOMATION_SPOOL_DIR=/var/lib/storex/automation
PLAYWRIGHT_BROWSERS_PATH=/opt/storex/shared/ms-playwright
# Optional only when the trusted Nextcloud hostname resolves to private addresses:
# AUTOMATION_ALLOWED_PRIVATE_HOSTS=cloud.example.org
# Optional additional administrator-approved official calendar source hosts:
# CALENDAR_APPROVED_SOURCE_HOSTS=approved.example.org
# CALENDAR_PYTHON=/opt/storex/calendar-venv/bin/python
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# REPORT_PDF_FONT_PATH=/opt/storex/shared/fonts/Persian.ttf
